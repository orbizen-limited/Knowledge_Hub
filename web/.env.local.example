# Copy to .env.local. Server-side only — never prefix with NEXT_PUBLIC_,
# these values must never reach the browser bundle.
KH_API_URL=http://127.0.0.1:4400/graphql
KH_API_KEY=CHANGE_ME_MATCH_SERVER_ENV_API_KEY

# Must match doctorshero-frontend's NEXTAUTH_SECRET exactly — this app has no
# login of its own, it decodes the doctor portal's shared session cookie
# (proxy.ts) instead of doctors having to log in twice.
NEXTAUTH_SECRET=CHANGE_ME_MATCH_DOCTORSHERO_FRONTEND_NEXTAUTH_SECRET
