# Copy to .env and fill in real values. Never commit .env.

# Postgres connection for the dedicated low-privilege role created for this service
DATABASE_URL=postgres://knowledge_hub_app:CHANGE_ME@127.0.0.1:5432/knowledge_hub

# Absolute path to the enriched Knowledge Hub JSON files in the doctorshero-rx checkout
INGEST_SOURCE_DIR=D:\doctorshero\helal-build\assets\knowledge_hub\enriched

# Server
PORT=4400
NODE_ENV=development

# Shared secret required in the X-Api-Key header on every GraphQL request (except /health)
API_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING

# Comma-separated list of allowed browser/service origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3400

# GraphQL query cost guardrails
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_COMPLEXITY=2000

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# In-process cache
CACHE_MAX_ENTRIES=500
CACHE_TTL_MS=300000
