{
  "name": "knowledge-hub-server",
  "version": "1.0.0",
  "private": true,
  "description": "DoctorsHero Knowledge Hub microservice API (Express + GraphQL + Postgres)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "ingest": "tsx scripts/ingest.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "graphql": "^16.11.0",
    "graphql-depth-limit": "^1.1.0",
    "helmet": "^8.1.0",
    "lru-cache": "^11.1.0",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
