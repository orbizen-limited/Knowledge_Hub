# =============================================================================
# DoctorsHero Knowledge Hub Enrichment Worker — environment
# Copy to .env and fill in. Loaded by app/main.py via python-dotenv.
# =============================================================================

# --- Server -------------------------------------------------------------------
# Loopback bind port (never expose via Apache).
KH_WORKER_PORT=4410
# Max concurrent enrichment jobs (extra jobs queue in-process). Default 1.
KH_WORKER_MAX_CONCURRENT=1

# --- Service-to-service auth (MUST match the Laravel backend's config) --------
# Shared secrets — use strong random 32+ char values, identical on both sides.
KH_WORKER_JWT_SECRET=change-me-strong-random-32-plus-chars
KH_WORKER_HMAC_SECRET=change-me-strong-random-32-plus-chars
# JWT time-to-live (seconds) and allowed clock skew (seconds).
KH_WORKER_JWT_TTL=60
KH_WORKER_CLOCK_SKEW=30

# --- Gemini generation --------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
KH_WORKER_GEMINI_MODEL=gemini-2.5-flash

# --- Crossref -----------------------------------------------------------------
# Polite-pool contact email included in the User-Agent (mailto).
KH_WORKER_CROSSREF_MAILTO=dev@doctorshero.com

# --- Pipeline tuning ----------------------------------------------------------
# Max validator-driven repair passes before giving up and reporting 'failed'.
KH_WORKER_MAX_REPAIR_PASSES=3
