# =============================================================================
# DoctorsHero Knowledge Hub Enrichment Worker — environment
# Copy to .env and fill in. Loaded by app/main.py via python-dotenv.
# =============================================================================

# --- Server -------------------------------------------------------------------
# Loopback bind port (never expose via Apache).
KH_WORKER_PORT=4410
# Max concurrent enrichment jobs (extra jobs queue in-process). Default 1.
KH_WORKER_MAX_CONCURRENT=1

# --- Service-to-service auth (MUST match the Laravel backend's config) --------
# Shared secrets — use strong random 32+ char values, identical on both sides.
KH_WORKER_JWT_SECRET=change-me-strong-random-32-plus-chars
KH_WORKER_HMAC_SECRET=change-me-strong-random-32-plus-chars
# JWT time-to-live (seconds) and allowed clock skew (seconds).
KH_WORKER_JWT_TTL=60
KH_WORKER_CLOCK_SKEW=30

# --- Gemini generation --------------------------------------------------------
# Prefer per-job llm config from Laravel (kh_llm_settings). GEMINI_* below is
# fallback when the job payload has no api_key for provider=gemini.
GEMINI_API_KEY=your-gemini-api-key
KH_WORKER_GEMINI_MODEL=gemini-2.5-flash
# USD per 1M tokens (defaults; admin settings override per job)
KH_WORKER_GEMINI_INPUT_USD_PER_M=0.15
KH_WORKER_GEMINI_OUTPUT_USD_PER_M=0.60
# Pre-flight estimate averages (tune after a few real jobs)
KH_WORKER_EST_PROMPT_TOKENS=90000
KH_WORKER_EST_OUTPUT_TOKENS=140000

# --- Crossref -----------------------------------------------------------------
# Polite-pool contact email included in the User-Agent (mailto).
KH_WORKER_CROSSREF_MAILTO=dev@doctorshero.com

# --- Pipeline tuning ----------------------------------------------------------
# Content standard: v9 (default) | v7 (legacy 5-group path)
KH_WORKER_CONTENT_STANDARD=v9
# v9 validator floors and modes (see worker/vendor/README_validator_v9.md)
KH_WORKER_V9_MIN_CHARS=100000
KH_WORKER_V9_MEDIA_MODE=QUERY-ONLY
KH_WORKER_V9_REFERENCE_MODE=R-STRICT
# Max validator-driven repair passes. After this many repairs still fail,
# the draft is accepted for board review (bypass) unless disabled below.
KH_WORKER_MAX_REPAIR_PASSES=3
# 1 = after max repairs, ingest anyway as pending_board_review with bypass flag.
# 0 = fail the job (old behaviour).
KH_WORKER_VALIDATOR_BYPASS=1
